---
import { getPageLocale } from '../../lib/locale';
import { messages } from '../../lib/messages';

export interface SlotButton {
  target?: string;
  key?: string;
  name: string | null;
  effect?: boolean;
  enabled?: boolean;
}

interface Props {
  buttons: SlotButton[];
}

const { buttons } = Astro.props;
const t = messages[getPageLocale(Astro.url.pathname).locale];
---

<ul class="slot-buttons">
  {buttons.map(({ target, key, name, effect, enabled }) => (
    <li>
      {target ? (
        <a class="slot-button" href={`#${target}`} data-slot-target={target}>
          {key && (
            <span class="slot-key" lang="en">
              {key}
            </span>
          )}
          <span class="slot-name" lang="en">
            {name}
          </span>
          {effect && (
            <span class="slot-status" data-enabled={enabled}>
              {enabled === undefined ? t.statusUnavailable : enabled ? 'ON' : 'OFF'}
            </span>
          )}
        </a>
      ) : (
        <span class="empty-slot">
          <span class="slot-key" lang="en">
            {key}
          </span>
          <span>{t.notSet}</span>
        </span>
      )}
    </li>
  ))}
</ul>

<style>
  .slot-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .slot-buttons li {
    min-width: 0;
    max-width: 100%;
  }

  .slot-button,
  .empty-slot {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.2rem 0.45rem;
    max-width: 100%;
    min-height: 44px;
    padding: 0.3rem 0.6rem;
    border: 1px solid var(--edge);
    border-radius: 0.3rem;
    overflow-wrap: anywhere;
  }

  .slot-button {
    background: var(--panel-face);
    box-shadow: var(--panel-shadow);
  }

  .slot-name {
    min-width: 0;
  }

  .empty-slot {
    color: var(--secondary);
    border-style: dashed;
  }

  .slot-key,
  .slot-status {
    color: var(--secondary);
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  .slot-status {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
  }

  .slot-status::before {
    content: '';
    flex: none;
    width: 0.45rem;
    height: 0.45rem;
    border: 1px dashed currentColor;
    border-radius: 50%;
  }

  .slot-status[data-enabled='false']::before {
    border-style: solid;
  }

  .slot-status[data-enabled='true'] {
    color: var(--signal);
  }

  .slot-status[data-enabled='true']::before {
    border-style: solid;
    background: currentColor;
    box-shadow: 0 0 0.35rem currentColor;
  }

  .slot-button:hover,
  .slot-button[aria-current='true'] {
    border-color: var(--signal);
  }

  .slot-button[aria-current='true'] {
    background: color-mix(in srgb, var(--signal) 12%, var(--recess));
    box-shadow: inset 0.2rem 0 var(--signal);
    color: var(--signal);
  }
</style>
