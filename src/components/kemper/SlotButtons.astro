---
import type { EffectCategory } from '../../lib/kemperEffectCategories';
import { getPageLocale } from '../../lib/locale';
import { messages } from '../../lib/messages';
import EffectStatus from './EffectStatus.astro';

export interface SlotButton {
  target?: string;
  key?: string;
  name: string | null;
  effect?: boolean;
  enabled?: boolean;
  category?: EffectCategory;
}

interface Props {
  buttons: SlotButton[];
}

const { buttons } = Astro.props;
const t = messages[getPageLocale(Astro.url.pathname).locale];
---

<ul class="slot-buttons">
  {buttons.map(({ target, key, name, effect, enabled, category }) => (
    <li>
      {target ? (
        <a
          class="slot-button"
          href={`#${target}`}
          data-slot-target={target}
          title={name ?? undefined}
        >
          <span class="slot-key" lang="en" aria-hidden={!key}>
            {key ?? '–'}
          </span>
          <span class="sr-only" lang="en">
            {name}
          </span>
          {effect && name !== null && (
            <EffectStatus name={name} category={category} enabled={enabled} indicatorOnly />
          )}
        </a>
      ) : (
        <span class="empty-slot">
          <span class="slot-key" lang="en">
            {key}
          </span>
          <span class="sr-only">{t.notSet}</span>
        </span>
      )}
    </li>
  ))}
</ul>

<style>
  .slot-buttons {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-evenly;
    row-gap: 0.3rem;
  }

  .slot-buttons li {
    min-width: 0;
    max-width: 100%;
  }

  .slot-button,
  .empty-slot {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.25rem;
    min-width: 44px;
    min-height: 44px;
    padding: 0.3rem;
    border: 1px solid var(--edge);
    border-radius: 0.3rem;
  }

  .slot-button {
    background: var(--panel-face);
    box-shadow: var(--panel-shadow);
  }

  .empty-slot {
    color: var(--secondary);
    border-style: dashed;
    background: var(--recess);
  }

  .slot-key {
    color: var(--secondary);
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  .slot-button:hover,
  .slot-button[aria-current='true'] {
    border-color: var(--signal);
  }

  .slot-button[aria-current='true'] {
    background: color-mix(in srgb, var(--signal) 12%, var(--recess));
    box-shadow: inset 0 -0.15rem var(--signal);
  }
</style>
