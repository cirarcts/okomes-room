---
import type { Locale } from '../../lib/locale';
import { messages } from '../../lib/messages';
import { formatDuration, youtubeWatchUrl, type VideoKind } from '../../lib/videoShelf';

interface Props {
  locale: Locale;
  videoId: string;
  title: string;
  publishedAt: Date;
  thumbnailUrl: string;
  channelName: string;
  channelUrl: string;
  /** 種別。手動で登録した動画などで未取得の場合は省略する。 */
  kind?: VideoKind;
  durationSeconds?: number;
  /** 公開元チャンネルのカテゴリの id（絞り込みに使う） */
  categories: readonly string[];
  /**
   * 表示の大きさ。`grid` は一覧のグリッド、`shelf` は横スクロールの棚、
   * `compact` は管理人コーナー用の小さめのカード。
   */
  variant?: 'grid' | 'shelf' | 'compact';
  /** 再生ステージで選択中かどうか */
  current?: boolean;
}

const {
  locale,
  videoId,
  title,
  publishedAt,
  thumbnailUrl,
  channelName,
  channelUrl,
  kind,
  durationSeconds,
  categories,
  variant = 'grid',
  current,
} = Astro.props;
const t = messages[locale];
const dateFormat = new Intl.DateTimeFormat(locale, { dateStyle: 'medium', timeZone: 'Asia/Tokyo' });
// 「通常」はラベルを付けず、区別が必要な種別だけを示す。
const kindLabel = kind === 'live' ? t.kindLive : kind === 'short' ? t.kindShort : undefined;
---

<li
  class:list={[
    // sr-only の要素が横スクロールの棚の外へはみ出さないよう、カードを配置の基準にする。
    'bg-surface border-muted/25 has-[[aria-current=true]]:border-accent/70 relative grid content-start overflow-hidden rounded-lg border transition-colors',
    variant === 'shelf' && 'w-64 shrink-0 snap-start sm:w-72',
    variant === 'compact' && 'w-48 shrink-0 snap-start sm:w-56',
  ]}
  data-video-item
  data-kind={kind}
  data-categories={categories.join(' ')}
  data-search={`${title} ${channelName}`}
>
  {/* JavaScriptが有効なときは再生ステージで再生し、無効なときはYouTubeの視聴ページを開く。 */}
  <a
    href={youtubeWatchUrl(videoId)}
    class="group grid content-start gap-3 pb-4 outline-offset-[-2px]"
    data-video-card
    data-video-id={videoId}
    data-title={title}
    data-channel-name={channelName}
    data-channel-url={channelUrl}
    aria-current={current ? 'true' : undefined}
  >
    {/* サムネイルは改変・被覆しない（規約）。種別や長さは画像の外に表示する。 */}
    <img
      src={thumbnailUrl}
      alt=""
      width="320"
      height="180"
      loading="lazy"
      decoding="async"
      class="aspect-video w-full bg-black object-cover opacity-90 transition-opacity group-hover:opacity-100"
    />
    <span
      class:list={[
        'group-hover:text-accent line-clamp-2 px-4 font-semibold transition-colors',
        variant === 'compact' && 'text-sm',
      ]}
    >
      {title}
    </span>
  </a>
  {(kindLabel || durationSeconds !== undefined) && (
    <p class="text-muted -mt-1 flex flex-wrap items-center gap-2 px-4 pb-3 text-xs">
      {kindLabel && (
        <span class="border-warm/50 text-warm rounded-sm border px-1.5 py-0.5">{kindLabel}</span>
      )}
      {durationSeconds !== undefined && (
        <span class="font-mono">
          <span class="sr-only">{t.duration}: </span>
          {formatDuration(durationSeconds)}
        </span>
      )}
    </p>
  )}
  {/* 公開元を明示する。チャンネル名はYouTubeのチャンネルページへのリンク。 */}
  <p class="text-muted -mt-2 flex flex-wrap justify-between gap-x-3 px-4 pb-4 text-sm">
    <a href={channelUrl} class="hover:text-fg underline-offset-4 hover:underline">
      {channelName}
    </a>
    <time datetime={publishedAt.toISOString().slice(0, 10)}>
      <span class="sr-only">{t.publishedOn}: </span>
      {dateFormat.format(publishedAt)}
    </time>
  </p>
</li>
