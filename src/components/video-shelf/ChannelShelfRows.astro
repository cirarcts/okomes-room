---
import type { ComponentProps } from 'astro/types';

import type { Locale } from '../../lib/locale';
import { messages } from '../../lib/messages';
import { channelRowQueueId, type ChannelShelfRow } from '../../lib/videoPreset';
import { SHELF_INITIAL_COUNT, youtubeChannelUrl, type ShelfChannel } from '../../lib/videoShelf';
import ShelfRow from './ShelfRow.astro';

interface Props {
  channel: ShelfChannel;
  locale: Locale;
  items: ComponentProps<typeof ShelfRow>['items'];
  variant?: 'shelf' | 'compact';
}

const { channel, locale, items, variant } = Astro.props;
const t = messages[locale];
// `tab` はYouTubeのチャンネルページのタブ。棚の続き（取得範囲より古い動画）を見る先として案内する。
const rows: {
  id: ChannelShelfRow;
  title: string;
  tab: string;
  moreText: string;
  items: Props['items'];
}[] = [
  {
    id: 'uploads',
    title: t.uploadVideos,
    tab: 'videos',
    moreText: t.openChannelVideos,
    items: items.filter(({ kind }) => kind !== 'live' && kind !== 'shorts'),
  },
  {
    id: 'archives',
    title: t.uploadArchives,
    tab: 'streams',
    moreText: t.openChannelStreams,
    items: items.filter(({ kind }) => kind === 'live'),
  },
  {
    id: 'shorts',
    title: 'Shorts',
    tab: 'shorts',
    moreText: t.openChannelShorts,
    items: items.filter(({ kind }) => kind === 'shorts'),
  },
];
---

{rows.map(({ id, title, tab, moreText, items }) => {
  if (items.length === 0) return null;
  const rowId = channelRowQueueId(channel.id, id);
  const label = `${channel.name} · ${title}`;
  return (
    <section aria-labelledby={`${rowId}-heading`} class="grid min-w-0 gap-2" data-filter-group>
      <h4 id={`${rowId}-heading`} class="text-muted text-sm font-semibold">
        {title}
      </h4>
      <ShelfRow
        queueId={rowId}
        label={label}
        items={items}
        variant={variant}
        initialCount={SHELF_INITIAL_COUNT}
        more={{
          href: `${youtubeChannelUrl(channel.channelId)}/${tab}`,
          text: moreText,
          label: `${moreText} · ${channel.name}`,
        }}
      />
    </section>
  );
})}
