---
import { isActivePath, NAV_ITEMS } from '../lib/navigation';
import { stripBase, withBase } from '../lib/paths';

const currentPath = stripBase(import.meta.env.BASE_URL, Astro.url.pathname);
const isHome = isActivePath(currentPath, '/');
---

<header
  class="border-surface bg-base/90 sticky top-0 z-40 border-b backdrop-blur-sm"
  data-site-header
>
  <div class="mx-auto flex h-14 max-w-5xl items-center justify-between gap-4 px-4">
    <a
      href={withBase('/')}
      aria-current={isHome ? 'page' : undefined}
      class="hover:text-accent flex min-h-11 items-center rounded-sm font-bold tracking-wide transition-colors"
    >
      okomeのおへや
    </a>

    {!isHome && (
      <>
        <button
          type="button"
          class="hover:bg-surface text-fg -mr-2 flex size-11 items-center justify-center rounded-md transition-colors md:hidden"
          aria-expanded="false"
          aria-controls="site-nav"
          data-nav-toggle
        >
          <span class="sr-only">メニュー</span>
          <svg
            class="size-6"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <path data-icon-open d="M4 7h16M4 12h16M4 17h16"></path>
            <path data-icon-close class="hidden" d="M6 6l12 12M18 6L6 18"></path>
          </svg>
        </button>

        <nav
          id="site-nav"
          aria-label="サイト内"
          class="max-md:border-surface max-md:bg-base hidden max-md:absolute max-md:inset-x-0 max-md:top-14 max-md:border-b md:block"
          data-nav
        >
          <ul class="flex flex-col max-md:px-4 max-md:py-2 md:flex-row md:gap-1">
            {NAV_ITEMS.map((item) => {
              const isCurrent = isActivePath(currentPath, item.href);
              return (
                <li>
                  <a
                    href={withBase(item.href)}
                    aria-current={isCurrent ? 'page' : undefined}
                    class:list={[
                      'flex min-h-11 items-center gap-3 rounded-md px-3 transition-colors md:flex-col md:justify-center md:gap-0',
                      'hover:bg-surface hover:text-fg',
                      isCurrent ? 'text-accent' : 'text-muted',
                    ]}
                  >
                    <span class="text-sm font-medium">{item.label}</span>
                    <span class="font-mono text-[0.625rem] tracking-widest uppercase">
                      {item.subLabel}
                    </span>
                  </a>
                </li>
              );
            })}
          </ul>
        </nav>
      </>
    )}
  </div>
</header>

<script>
  // スマートフォン用メニューの開閉。PC幅ではCSSで常時表示されるため影響しない。
  const header = document.querySelector<HTMLElement>('[data-site-header]');
  const toggle = header?.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const nav = header?.querySelector<HTMLElement>('[data-nav]');

  if (header && toggle && nav) {
    const isOpen = () => toggle.getAttribute('aria-expanded') === 'true';

    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      nav.classList.toggle('hidden', !open);
      toggle.querySelector('[data-icon-open]')?.classList.toggle('hidden', open);
      toggle.querySelector('[data-icon-close]')?.classList.toggle('hidden', !open);
    };

    toggle.addEventListener('click', () => setOpen(!isOpen()));

    // Escapeで閉じ、フォーカスを開閉ボタンへ戻す
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && isOpen()) {
        setOpen(false);
        toggle.focus();
      }
    });

    // メニューの外側を操作したら閉じる
    document.addEventListener('click', (event) => {
      if (isOpen() && event.target instanceof Node && !header.contains(event.target)) {
        setOpen(false);
      }
    });
  }
</script>
