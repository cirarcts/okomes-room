---
import '../styles/global.css';

import SiteHeader from '../components/SiteHeader.astro';
import { withBase } from '../lib/paths';

interface Props {
  /** ページ固有のタイトル。省略時はサイト名のみを表示する。 */
  title?: string;
  description?: string;
}

const SITE_NAME = 'okomeのおへや';
const DEFAULT_DESCRIPTION = '好きなものを、好きなだけ。okomeの記録や作品を集めたおへや。';

const { title, description = DEFAULT_DESCRIPTION } = Astro.props;
const pageTitle = title ? `${title} | ${SITE_NAME}` : SITE_NAME;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <title>{pageTitle}</title>
    <!-- JavaScriptが無効でもナビゲーションを使えるよう、スマートフォン用メニューを常時表示にする -->
    <noscript>
      <style>
        [data-nav] {
          display: block !important;
          position: static !important;
        }
        [data-nav-toggle] {
          display: none !important;
        }
        [data-site-header]:has([data-nav]) > div {
          height: auto !important;
          flex-wrap: wrap;
        }
      </style>
    </noscript>
  </head>
  <body class="bg-base text-fg flex min-h-screen flex-col antialiased">
    <a
      href="#main"
      class="bg-surface text-fg sr-only z-50 rounded-md px-4 py-2 focus:not-sr-only focus:fixed focus:top-2 focus:left-2"
    >
      本文へスキップ
    </a>
    <SiteHeader>
      <slot name="header-action" />
    </SiteHeader>
    <main id="main" tabindex="-1" class="flex flex-1 flex-col outline-none">
      <slot />
    </main>
  </body>
</html>
