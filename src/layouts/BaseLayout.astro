---
import '../styles/global.css';

import SiteHeader from '../components/SiteHeader.astro';
import { getPageLocale, localizedPath, locales } from '../lib/locale';
import { messages } from '../lib/messages';
import { withBase } from '../lib/paths';

interface Props {
  /** ページ固有のタイトル。省略時はサイト名のみを表示する。 */
  title?: string;
  description?: string;
}

const { locale, path } = getPageLocale(Astro.url.pathname);
const t = messages[locale];

const { title, description = t.siteDescription } = Astro.props;
const pageTitle = title ? `${title} | ${t.siteName}` : t.siteName;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <title>{pageTitle}</title>
    {locales.map((language) => {
      const href = localizedPath(language, path);
      return (
        <link
          rel="alternate"
          hreflang={language}
          href={Astro.site ? new URL(href, Astro.site) : href}
        />
      );
    })}
    <slot name="head" />
    <!-- JavaScriptが無効でもナビゲーションを使えるよう、スマートフォン用メニューを常時表示にする -->
    <noscript>
      <style>
        @media (width < 48rem) {
          [data-nav] {
            display: block !important;
            position: static !important;
            order: 1;
            width: 100%;
          }
          [data-nav-toggle] {
            display: none !important;
          }
          [data-site-header]:has([data-nav]) > div {
            height: auto !important;
            flex-wrap: wrap;
          }
        }
      </style>
    </noscript>
  </head>
  <body class="bg-base text-fg flex min-h-screen flex-col antialiased">
    <a
      href="#main"
      class="bg-surface text-fg sr-only z-50 rounded-md px-4 py-2 focus:not-sr-only focus:fixed focus:top-2 focus:left-2"
    >
      {t.skipToContent}
    </a>
    <SiteHeader />
    <main id="main" tabindex="-1" class="flex flex-1 flex-col outline-none">
      <slot />
    </main>
  </body>
</html>
