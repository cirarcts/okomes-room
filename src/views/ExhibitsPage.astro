---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPageLocale, localizedPath } from '../lib/locale';
import { messages } from '../lib/messages';

const { locale } = getPageLocale(Astro.url.pathname);
const t = messages[locale];

const description = t.exhibitsDescription;
const title = locale === 'ja' ? '展示室' : 'Exhibits';
---

<BaseLayout title={title} description={description}>
  <section class="mx-auto w-full max-w-5xl px-4 py-12 sm:py-20" aria-labelledby="exhibits-title">
    <header class="mb-8 grid gap-3 sm:mb-10">
      {locale === 'ja' && (
        <p class="text-accent font-mono text-sm tracking-widest" lang="en">
          Exhibits
        </p>
      )}
      <h1 id="exhibits-title" class="text-3xl font-bold sm:text-4xl">
        {title}
      </h1>
      <p class="text-muted">{description}</p>
    </header>

    <ul class="grid gap-3">
      {[
        {
          id: 'kemper',
          href: '/exhibits/kemper/',
          title: 'Kemper Rig Viewer',
          titleLang: 'en',
          description: t.kemperDescription,
        },
        {
          id: 'video-shelf',
          href: '/exhibits/video-shelf/',
          title: t.videoShelfTitle,
          titleLang: locale,
          description: t.videoShelfDescription,
        },
      ].map((exhibit) => (
        <li>
          <a
            href={localizedPath(locale, exhibit.href)}
            class="bg-surface hover:bg-subtle border-muted/25 hover:border-accent/60 grid grid-cols-[minmax(0,1fr)_auto] items-center gap-4 rounded-lg border px-5 py-6 transition-colors sm:px-7"
            aria-labelledby={`${exhibit.id}-entry-title`}
            aria-describedby={`${exhibit.id}-entry-description`}
          >
            <div class="grid gap-2">
              <h2
                id={`${exhibit.id}-entry-title`}
                class="text-lg font-semibold sm:text-xl"
                lang={exhibit.titleLang}
              >
                {exhibit.title}
              </h2>
              <p id={`${exhibit.id}-entry-description`} class="text-muted text-sm">
                {exhibit.description}
              </p>
            </div>
            <span class="text-accent text-lg" aria-hidden="true">
              →
            </span>
          </a>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>
