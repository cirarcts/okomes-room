---
import { getCollection } from 'astro:content';

import VideoCard from '../components/video-shelf/VideoCard.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPageLocale, localizedPath } from '../lib/locale';
import { messages } from '../lib/messages';
import {
  EMBED_BASE_URL,
  buildShelf,
  youtubeChannelUrl,
  youtubeThumbnailUrl,
  youtubeWatchUrl,
} from '../lib/videoShelf';

const { locale } = getPageLocale(Astro.url.pathname);
const t = messages[locale];

const channels = (await getCollection('videoChannels')).map(({ data }) => data);
const activeChannels = channels
  .filter((channel) => channel.enabled)
  .sort((a, b) => a.name.localeCompare(b.name, 'ja'));

// おすすめ棚：手動で選んだ動画。チャンネルをまたいで並べる（API Dataではない）。
const picks = buildShelf(
  channels,
  (await getCollection('shelfVideos')).map(({ data }) => data),
);

// チャンネルの新着：ビルド時に自動取得したデータ。規約に合わせてチャンネルごとに分けて表示する。
const uploadsById = new Map(
  (await getCollection('channelUploads')).map(({ data }) => [data.channel, data]),
);
const channelShelves = activeChannels.flatMap((channel) => {
  const uploads = uploadsById.get(channel.id);
  return uploads ? [{ channel, uploads }] : [];
});

// 再生ステージの初期表示は、おすすめ棚の先頭（なければ最初のチャンネルの新着）。
const firstUpload = channelShelves.find(({ uploads }) => uploads.videos.length > 0);
const stage = picks[0]
  ? {
      id: picks[0].id,
      title: picks[0].title,
      channelName: picks[0].channelData.name,
      channelUrl: youtubeChannelUrl(picks[0].channelData.channelId),
    }
  : firstUpload
    ? {
        id: firstUpload.uploads.videos[0].id,
        title: firstUpload.uploads.videos[0].title,
        channelName: firstUpload.channel.name,
        channelUrl: youtubeChannelUrl(firstUpload.channel.channelId),
      }
    : undefined;

const fetchedAtFormat = new Intl.DateTimeFormat(locale, {
  dateStyle: 'medium',
  timeStyle: 'short',
  timeZone: 'Asia/Tokyo',
});
const countLabel = (count: number) =>
  locale === 'en' && count === 1 ? '1 video' : t.videoCount.replace('{count}', String(count));
---

<BaseLayout title={t.videoShelfTitle} description={t.videoShelfDescription}>
  <section class="mx-auto w-full max-w-6xl px-4 py-8 sm:py-14" aria-labelledby="video-shelf-title">
    <a
      href={localizedPath(locale, '/exhibits/')}
      class="text-accent hover:text-fg mb-4 inline-flex min-h-11 items-center gap-2 rounded-sm text-sm underline-offset-4 hover:underline"
    >
      <span aria-hidden="true">←</span>
      {t.backToExhibits}
    </a>
    <header class="mb-6 grid gap-2">
      {locale === 'ja' && (
        <p class="text-accent font-mono text-sm tracking-widest" lang="en">
          Video Shelf
        </p>
      )}
      <h1 id="video-shelf-title" class="text-2xl font-bold sm:text-4xl">
        {t.videoShelfTitle}
      </h1>
      <p class="text-muted">{t.videoShelfDescription}</p>
    </header>

    {stage ? (
      // 再生ステージ。JavaScriptが無効な場合は、サムネイルからYouTubeの視聴ページへ移動する。
      <div
        class="mx-auto mb-10 grid w-full max-w-4xl gap-3"
        data-video-stage
        data-embed-base={EMBED_BASE_URL}
      >
        <div
          class="border-accent/30 relative aspect-video w-full overflow-hidden rounded-lg border bg-black shadow-[0_0_40px_-12px] shadow-cyan-400/30"
          data-stage-frame
        >
          <a
            href={youtubeWatchUrl(stage.id)}
            class="group absolute inset-0 grid place-items-center"
            data-stage-facade
            aria-label={t.playVideo.replace('{title}', stage.title)}
          >
            <img
              src={youtubeThumbnailUrl(stage.id, 'hqdefault')}
              alt=""
              width="480"
              height="360"
              decoding="async"
              class="absolute inset-0 size-full object-cover opacity-80 transition-opacity group-hover:opacity-100"
            />
            <span
              class="bg-base/80 border-accent/70 text-accent group-hover:bg-base relative grid size-16 place-items-center rounded-full border-2 transition-colors sm:size-20"
              aria-hidden="true"
            >
              <svg viewBox="0 0 24 24" class="ml-1 size-7 fill-current sm:size-9">
                <path d="M8 5v14l11-7z" />
              </svg>
            </span>
          </a>
        </div>
        <div class="grid gap-1">
          <h2 class="text-lg font-semibold sm:text-xl" data-stage-title>
            {stage.title}
          </h2>
          <p class="text-muted flex flex-wrap items-center gap-x-3 gap-y-1 text-sm">
            <a
              href={stage.channelUrl}
              class="text-accent hover:text-fg underline-offset-4 hover:underline"
              data-stage-channel
            >
              {stage.channelName}
            </a>
            <a
              href={youtubeWatchUrl(stage.id)}
              class="hover:text-fg underline-offset-4 hover:underline"
              data-stage-watch
            >
              {t.openOnYouTube}
              <span aria-hidden="true">↗</span>
            </a>
          </p>
        </div>
      </div>
    ) : (
      <p class="bg-surface border-muted/25 text-muted mb-12 rounded-lg border p-6">{t.noVideos}</p>
    )}

    {stage && (
      // 絞り込み。JavaScriptが無効な場合は使えないため、スクリプトで表示する。
      <div
        id="video-filter"
        class="bg-subtle border-muted/20 mb-10 grid gap-4 rounded-lg border p-4 sm:p-5"
        hidden
      >
        <div class="grid gap-2">
          <label for="video-query" class="text-sm font-semibold">
            {t.searchVideos}
          </label>
          <input
            id="video-query"
            type="search"
            placeholder={t.videoSearchPlaceholder}
            class="bg-surface border-muted/40 min-h-11 w-full max-w-md rounded-md border px-3"
          />
        </div>
        <fieldset class="grid gap-2" aria-describedby="video-kind-note">
          <legend class="mb-2 text-sm font-semibold">{t.videoKind}</legend>
          <div class="flex flex-wrap gap-2">
            {(
              [
                ['all', t.kindAll],
                ['regular', t.kindRegular],
                ['short', t.kindShort],
                ['live', t.kindLive],
              ] as const
            ).map(([value, label]) => (
              <label class="bg-surface border-muted/30 has-checked:border-accent/70 has-checked:text-accent has-focus-visible:outline-accent inline-flex min-h-11 cursor-pointer items-center rounded-full border px-4 text-sm transition-colors has-focus-visible:outline-2 has-focus-visible:outline-offset-2">
                <input
                  type="radio"
                  name="video-kind"
                  value={value}
                  class="sr-only"
                  checked={value === 'all'}
                />
                {label}
              </label>
            ))}
          </div>
          <p id="video-kind-note" class="text-muted text-xs">
            {t.kindNote}
          </p>
        </fieldset>
        <p
          id="video-count"
          role="status"
          class="text-muted text-sm"
          data-empty={t.noMatchingVideos}
          data-singular={
            locale === 'en' ? '1 matching video' : t.matchingVideos.replace('{count}', '1')
          }
          data-count={t.matchingVideos}
        ></p>
      </div>
    )}

    {picks.length > 0 && (
      <section aria-labelledby="picks-title" class="mb-12">
        <div class="mb-4 flex items-baseline justify-between gap-4">
          <h2 id="picks-title" class="text-xl font-semibold">
            {t.picks}
          </h2>
          <p class="text-muted text-sm">{countLabel(picks.length)}</p>
        </div>
        <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3" data-shelf-list>
          {picks.map((video) => (
            <VideoCard
              locale={locale}
              videoId={video.id}
              title={video.title}
              publishedAt={video.publishedAt}
              thumbnailUrl={youtubeThumbnailUrl(video.id, 'mqdefault')}
              channelName={video.channelData.name}
              channelUrl={youtubeChannelUrl(video.channelData.channelId)}
              kind={video.kind}
              current={video.id === stage?.id}
            />
          ))}
        </ul>
        <p class="text-muted text-sm" data-shelf-empty hidden>
          {t.noMatchingVideos}
        </p>
      </section>
    )}

    {channelShelves.length > 0 && (
      <section aria-labelledby="channel-latest-title" class="mb-12 grid gap-8">
        <h2 id="channel-latest-title" class="text-xl font-semibold">
          {t.channelLatest}
        </h2>
        {channelShelves.map(({ channel, uploads }) => (
          <section
            aria-labelledby={`channel-${channel.id}-title`}
            class="border-muted/20 grid gap-4 border-l-2 pl-4"
          >
            <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
              <h3
                id={`channel-${channel.id}-title`}
                class="flex items-baseline gap-2 font-semibold"
              >
                <a
                  href={youtubeChannelUrl(channel.channelId)}
                  class="hover:text-accent underline-offset-4 hover:underline"
                >
                  {channel.name}
                </a>
                {channel.category && (
                  <span class="text-warm font-mono text-xs">{channel.category}</span>
                )}
              </h3>
              <p class="text-muted text-xs">
                {t.fetchedAt.replace('{date}', fetchedAtFormat.format(uploads.fetchedAt))}
              </p>
            </div>
            {uploads.status === 'error' ? (
              <p class="text-muted text-sm">{t.fetchFailed}</p>
            ) : uploads.videos.length === 0 ? (
              <p class="text-muted text-sm">{t.noUploads}</p>
            ) : (
              <>
                <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3" data-shelf-list>
                  {uploads.videos.map((video) => (
                    <VideoCard
                      locale={locale}
                      videoId={video.id}
                      title={video.title}
                      publishedAt={video.publishedAt}
                      thumbnailUrl={
                        video.thumbnailUrl ?? youtubeThumbnailUrl(video.id, 'mqdefault')
                      }
                      channelName={channel.name}
                      channelUrl={youtubeChannelUrl(channel.channelId)}
                      kind={video.kind}
                      durationSeconds={video.durationSeconds}
                      current={video.id === stage?.id}
                    />
                  ))}
                </ul>
                <p class="text-muted text-sm" data-shelf-empty hidden>
                  {t.noMatchingVideos}
                </p>
              </>
            )}
          </section>
        ))}
      </section>
    )}

    {activeChannels.length > 0 && (
      <section aria-labelledby="channel-list-title" class="mb-12">
        <h2 id="channel-list-title" class="mb-4 text-xl font-semibold">
          {t.registeredChannels}
        </h2>
        <ul class="flex flex-wrap gap-2">
          {activeChannels.map((channel) => (
            <li>
              <a
                href={youtubeChannelUrl(channel.channelId)}
                class="bg-surface border-muted/25 hover:border-accent/60 inline-flex min-h-11 items-center gap-2 rounded-full border px-4 text-sm transition-colors"
              >
                {channel.name}
                {channel.category && (
                  <span class="text-warm font-mono text-xs">{channel.category}</span>
                )}
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    <footer class="border-muted/20 text-muted grid gap-2 border-t pt-6 text-xs">
      <p>{t.playerNotice}</p>
      {channelShelves.length > 0 && <p>{t.apiNotice}</p>}
      <p class="flex flex-wrap gap-x-4 gap-y-1">
        <a
          href="https://www.youtube.com/t/terms"
          class="hover:text-fg underline underline-offset-4"
          rel="noopener noreferrer"
        >
          {t.youtubeTerms}
        </a>
        <a
          href="https://policies.google.com/privacy"
          class="hover:text-fg underline underline-offset-4"
          rel="noopener noreferrer"
        >
          {t.googlePrivacy}
        </a>
      </p>
    </footer>
  </section>
</BaseLayout>

<script>
  import {
    VIDEO_ID_PATTERN,
    VIDEO_KINDS,
    matchesVideoFilter,
    normalizeSearchText,
    parseSearchTerms,
    type VideoKind,
  } from '../lib/videoShelf';

  const stage = document.querySelector<HTMLElement>('[data-video-stage]');
  const cards = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-video-card]'));

  if (stage) {
    const embedBase = stage.dataset.embedBase ?? '';
    const frame = stage.querySelector<HTMLElement>('[data-stage-frame]');
    const title = stage.querySelector<HTMLElement>('[data-stage-title]');
    const channel = stage.querySelector<HTMLAnchorElement>('[data-stage-channel]');
    const watch = stage.querySelector<HTMLAnchorElement>('[data-stage-watch]');
    const facade = stage.querySelector<HTMLAnchorElement>('[data-stage-facade]');

    // 再生ボタンが押されたときに初めて公式プレイヤーを読み込む（自動再生はユーザー操作の直後のみ）。
    const play = (card: HTMLAnchorElement) => {
      const videoId = card.dataset.videoId ?? '';
      if (!frame || !VIDEO_ID_PATTERN.test(videoId)) return false;

      const iframe = document.createElement('iframe');
      iframe.src = `${embedBase}${videoId}?autoplay=1`;
      iframe.title = card.dataset.title ?? 'YouTube video player';
      iframe.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
      iframe.referrerPolicy = 'strict-origin-when-cross-origin';
      iframe.className = 'absolute inset-0 size-full';
      frame.replaceChildren(iframe);

      if (title && card.dataset.title) title.textContent = card.dataset.title;
      if (channel && card.dataset.channelName && card.dataset.channelUrl) {
        channel.textContent = card.dataset.channelName;
        channel.href = card.dataset.channelUrl;
      }
      if (watch) watch.href = card.href;
      // 同じ動画がおすすめ棚とチャンネルの新着の両方にある場合は、両方を選択中にする。
      for (const other of cards) {
        if (other.dataset.videoId === videoId) other.setAttribute('aria-current', 'true');
        else other.removeAttribute('aria-current');
      }

      // プレイヤーが画面外にある場合（スマートフォンで一覧を下へ進んだときなど）は表示位置まで戻す。
      const rect = frame.getBoundingClientRect();
      if (rect.top < 0 || rect.bottom > window.innerHeight) {
        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        frame.scrollIntoView({ behavior: reduceMotion ? 'auto' : 'smooth', block: 'center' });
      }
      iframe.focus({ preventScroll: true });
      return true;
    };

    const handleClick = (event: MouseEvent, card: HTMLAnchorElement) => {
      // 修飾キー付きのクリックは通常のリンクとしてYouTubeで開く。
      if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) {
        return;
      }
      if (play(card)) event.preventDefault();
    };

    for (const card of cards) {
      card.addEventListener('click', (event) => handleClick(event, card));
    }
    facade?.addEventListener('click', (event) => {
      const current = cards.find((card) => card.getAttribute('aria-current') === 'true');
      if (current) handleClick(event, current);
    });
  }

  // タイトル・チャンネル名での検索と、種別での絞り込み。
  const filter = document.querySelector<HTMLElement>('#video-filter');
  const query = document.querySelector<HTMLInputElement>('#video-query');
  const count = document.querySelector<HTMLElement>('#video-count');
  const kindInputs = Array.from(
    document.querySelectorAll<HTMLInputElement>('input[name="video-kind"]'),
  );
  const isVideoKind = (value: string | undefined): value is VideoKind =>
    VIDEO_KINDS.some((kind) => kind === value);
  const items = Array.from(document.querySelectorAll<HTMLElement>('[data-video-item]'), (item) => ({
    item,
    videoId: item.querySelector<HTMLElement>('[data-video-card]')?.dataset.videoId ?? '',
    search: normalizeSearchText(item.dataset.search ?? ''),
    kind: isVideoKind(item.dataset.kind) ? item.dataset.kind : undefined,
  }));
  const lists = Array.from(document.querySelectorAll<HTMLElement>('[data-shelf-list]'));

  if (filter && query && count && items.length > 0) {
    const updateResults = () => {
      const selected = kindInputs.find((input) => input.checked)?.value;
      const kind = isVideoKind(selected) ? selected : 'all';
      const terms = parseSearchTerms(query.value);
      // おすすめと新着の両方にある動画は1本として数える。
      const matched = new Set<string>();
      for (const entry of items) {
        entry.item.hidden = !matchesVideoFilter(entry.search, entry.kind, { terms, kind });
        if (!entry.item.hidden) matched.add(entry.videoId);
      }
      for (const list of lists) {
        const empty = !Array.from(list.children).some(
          (child) => child instanceof HTMLElement && !child.hidden,
        );
        list.hidden = empty;
        const message = list.nextElementSibling;
        if (message instanceof HTMLElement && message.hasAttribute('data-shelf-empty')) {
          message.hidden = !empty;
        }
      }
      count.textContent =
        (matched.size === 0
          ? count.dataset.empty
          : matched.size === 1
            ? count.dataset.singular
            : count.dataset.count?.replace('{count}', String(matched.size))) ?? '';
    };

    filter.hidden = false;
    updateResults();
    query.addEventListener('input', updateResults);
    for (const input of kindInputs) input.addEventListener('change', updateResults);
    // ブラウザの「戻る」で入力内容が復元された場合にも結果を合わせる。
    window.addEventListener('pageshow', updateResults);
  }
</script>
