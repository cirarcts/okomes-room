---
import { getCollection } from 'astro:content';

import ChannelShelfRows from '../components/video-shelf/ChannelShelfRows.astro';
import ShelfRow from '../components/video-shelf/ShelfRow.astro';
import VideoCard from '../components/video-shelf/VideoCard.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPageLocale, localizedPath } from '../lib/locale';
import { messages } from '../lib/messages';
import { buildPlaylist, collectTags, sortPlaylists, type Playlist } from '../lib/videoPlaylist';
import {
  CHANNEL_SHELF_ROWS,
  PRESET_PARAM,
  channelRowQueueId,
  playlistQueueId,
  validatePresets,
} from '../lib/videoPreset';
import {
  EMBED_BASE_URL,
  buildShelf,
  sortCategories,
  sortChannels,
  validateShelfConfig,
  youtubeChannelUrl,
  youtubeThumbnailUrl,
  type ShelfChannel,
  type ShelfItem,
} from '../lib/videoShelf';

const { locale } = getPageLocale(Astro.url.pathname);
const t = messages[locale];

const categories = sortCategories((await getCollection('videoCategories')).map(({ data }) => data));
const channels = (await getCollection('videoChannels')).map(({ data }) => data);
validateShelfConfig(channels, categories);

const activeChannels = sortChannels(channels.filter((channel) => channel.enabled));
const fanChannels = activeChannels.filter((channel) => !channel.owner);
const ownerChannel = activeChannels.find((channel) => channel.owner);
const categoryName = (id: string) => {
  const category = categories.find((entry) => entry.id === id);
  return category ? (locale === 'en' ? category.nameEn : category.name) : id;
};
// 絞り込みには、表示中のチャンネルで使われているカテゴリだけを並べる。
const usedCategories = categories.filter((category) =>
  activeChannels.some((channel) => channel.categories.includes(category.id)),
);

// 手動で選んだ推しの動画（おすすめ）。チャンネルをまたいで並べる（API Dataではないため）。
// 管理人の代表作は視聴回数から自動で選ぶため、管理人チャンネルの動画は登録しない。
const fanPicks = buildShelf(
  channels,
  (await getCollection('shelfVideos')).map(({ data }) => data),
);
const misplacedPicks = fanPicks.filter((video) => video.channelData.owner);
if (misplacedPicks.length > 0) {
  throw new Error(
    `管理人チャンネルの動画は videos.json に登録しません（代表作は自動で選びます）: ${misplacedPicks.map((video) => video.id).join(', ')}`,
  );
}

// 手動のプレイリスト。動画の情報はすべて手動で記入したもので、チャンネルをまたいで並べる（API Dataではないため）。
const playlistInputs = (await getCollection('videoPlaylists')).map(({ data }) => data);
const playlists = sortPlaylists(playlistInputs.map((data) => buildPlaylist(data, channels))).filter(
  (playlist) => playlist.items.length > 0,
);
// 絞り込みのチップに並べるタグ（表示するプレイリストの項目のもの）。
const sceneTags = collectTags(playlists);
const playlistName = (playlist: Playlist) => (locale === 'en' ? playlist.nameEn : playlist.name);

// 再生プリセット。対象は1つの棚。棚の存在はデータから確かめ、動画の取得に失敗して空になった棚は
// ページ側で隠す（取得の失敗でビルドを止めないため）。
const knownQueueIds = new Set<string>([
  ...playlistInputs.map(({ id }) => playlistQueueId(id)),
  'picks',
  'owner-works',
  ...activeChannels.flatMap((channel) =>
    CHANNEL_SHELF_ROWS.map((row) => channelRowQueueId(channel.id, row)),
  ),
]);
const presets = validatePresets(
  (await getCollection('videoPresets')).map(({ data }) => data),
  knownQueueIds,
);
const presetName = (preset: (typeof presets)[number]) =>
  locale === 'en' ? preset.nameEn : preset.name;

// チャンネルの新着：ビルド時に自動取得したデータ。規約に合わせてチャンネルごとに分けて表示する。
const uploadsById = new Map(
  (await getCollection('channelUploads')).map(({ data }) => [data.channel, data]),
);
const fanShelves = fanChannels.flatMap((channel) => {
  const uploads = uploadsById.get(channel.id);
  return uploads ? [{ channel, uploads }] : [];
});
const ownerUploads = ownerChannel ? uploadsById.get(ownerChannel.id) : undefined;
const ownerPopular = ownerUploads?.popular ?? [];

type Uploads = NonNullable<typeof ownerUploads>;

function pickCard(video: ShelfItem) {
  return {
    locale,
    videoId: video.id,
    title: video.title,
    publishedAt: video.publishedAt,
    thumbnailUrl: youtubeThumbnailUrl(video.id, 'mqdefault'),
    channelName: video.channelData.name,
    channel: video.channelData.id,
    manualTitle: true,
    channelUrl: youtubeChannelUrl(video.channelData.channelId),
    kind: video.kind,
    categories: video.channelData.categories,
  };
}

function playlistCard(item: Playlist['items'][number]) {
  return {
    locale,
    videoId: item.videoId,
    title: item.title,
    thumbnailUrl: youtubeThumbnailUrl(item.videoId, 'mqdefault'),
    channelName: item.channelData.name,
    channel: item.channelData.id,
    manualTitle: true,
    channelUrl: youtubeChannelUrl(item.channelData.channelId),
    categories: item.channelData.categories,
    playlistItem: {
      key: item.key,
      startSeconds: item.startSeconds,
      endSeconds: item.endSeconds,
      note: item.note,
      weight: item.weight,
      tags: item.tags,
    },
  };
}

function uploadCard(
  channel: ShelfChannel,
  video: Uploads['videos'][number] | NonNullable<Uploads['popular']>[number],
) {
  return {
    locale,
    videoId: video.id,
    title: video.title,
    publishedAt: video.publishedAt,
    thumbnailUrl: video.thumbnailUrl ?? youtubeThumbnailUrl(video.id, 'mqdefault'),
    channelName: channel.name,
    channel: channel.id,
    channelUrl: youtubeChannelUrl(channel.channelId),
    kind: video.kind,
    durationSeconds: video.durationSeconds,
    viewCount: 'viewCount' in video ? video.viewCount : undefined,
    categories: channel.categories,
  };
}

// 再生ステージは、動画を選ぶまで案内だけを表示する（初期表示の動画は決めない）。
const hasVideos =
  playlists.length > 0 ||
  fanPicks.length > 0 ||
  fanShelves.some(({ uploads }) => uploads.videos.length > 0) ||
  ownerPopular.length > 0 ||
  (ownerUploads?.videos.length ?? 0) > 0;

const fetchedAtFormat = new Intl.DateTimeFormat(locale, {
  dateStyle: 'medium',
  timeStyle: 'short',
  timeZone: 'Asia/Tokyo',
});
const countLabel = (count: number) =>
  locale === 'en' && count === 1 ? '1 video' : t.videoCount.replace('{count}', String(count));
const hasApiData = uploadsById.size > 0;

// 前へ・次へ。狭い画面では横長のボタン、広い画面ではプレイヤーの左右に「ラベル＋大きなアイコン」を縦に並べる。
const navButtonClass =
  'group bg-surface border-muted/30 hover:border-accent/60 text-fg inline-flex min-h-11 items-center justify-center gap-2 rounded-full border px-4 text-sm transition-colors disabled:cursor-not-allowed disabled:opacity-40 lg:flex-col lg:rounded-xl lg:border-0 lg:bg-transparent lg:px-0 lg:text-muted lg:enabled:hover:text-fg';
const navIconClass =
  'grid place-items-center text-accent lg:bg-surface lg:border-muted/40 lg:size-18 lg:rounded-xl lg:border-2 lg:shadow-[0_0_24px_-10px] lg:shadow-cyan-400/40 lg:transition-colors lg:group-enabled:group-hover:border-accent/70';
---

<BaseLayout title={t.videoShelfTitle} description={t.videoShelfDescription}>
  <section class="mx-auto w-full max-w-6xl px-4 py-8 sm:py-14" aria-labelledby="video-shelf-title">
    <a
      href={localizedPath(locale, '/exhibits/')}
      class="text-accent hover:text-fg mb-4 inline-flex min-h-11 items-center gap-2 rounded-sm text-sm underline-offset-4 hover:underline"
    >
      <span aria-hidden="true">←</span>
      {t.backToExhibits}
    </a>
    <header class="mb-6 grid gap-2">
      {locale === 'ja' && (
        <p class="text-accent font-mono text-sm tracking-widest" lang="en">
          Video Shelf
        </p>
      )}
      <h1 id="video-shelf-title" class="text-2xl font-bold sm:text-4xl">
        {t.videoShelfTitle}
      </h1>
      <p class="text-muted">{t.videoShelfDescription}</p>
    </header>

    {hasVideos ? (
      // 再生ステージ。動画を選ぶまでは案内を表示する。JavaScriptが無効な場合は再生できないため、スクリプトで表示する。
      <div class="mb-10 grid gap-3" data-video-stage data-embed-base={EMBED_BASE_URL} hidden>
        {presets.length > 0 && (
          // 再生プリセット。リンク（?preset=…）なので、ブックマークや新しいタブでも開ける。
          <div
            class="mx-auto flex w-full max-w-4xl flex-wrap items-center gap-x-3 gap-y-2"
            data-player-presets
            data-msg-preset-cued={t.presetCued}
            data-msg-preset-empty={t.presetEmpty}
          >
            <p id="video-presets-label" class="text-muted text-sm">
              {t.presets}
            </p>
            <ul class="flex flex-wrap gap-2" aria-labelledby="video-presets-label">
              {presets.map((preset) => (
                <li>
                  <a
                    href={`?${PRESET_PARAM}=${preset.id}`}
                    class="bg-surface border-muted/30 hover:border-accent/60 aria-[current=true]:border-accent/70 aria-[current=true]:bg-accent/15 inline-flex min-h-11 flex-wrap items-center gap-x-2 rounded-full border px-4 py-1 text-sm transition-colors"
                    data-preset-link
                    data-preset-id={preset.id}
                    data-preset-name={presetName(preset)}
                    data-preset-queue={preset.queue}
                    data-preset-order={preset.playOrder}
                    data-preset-repeat={preset.repeat ? 'true' : 'false'}
                  >
                    <span class="text-fg">{presetName(preset)}</span>
                    <span class="text-muted text-xs">
                      {[
                        preset.playOrder === 'shuffle' ? t.playShuffle : t.playOrdered,
                        preset.repeat ? t.presetRepeat : undefined,
                      ]
                        .filter(Boolean)
                        .join(' · ')}
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}
        {/*
          プレイヤーと前へ・次へ。広い画面ではプレイヤーの左右、狭い画面ではプレイヤーの下に並べる。
          ボタンはプレイヤーに重ねない（規約 RMF）。動画を選ぶまでは表示しない。
        */}
        <div class="grid grid-cols-2 gap-3 lg:grid-cols-[5.5rem_minmax(0,56rem)_5.5rem] lg:items-center lg:justify-center lg:gap-5">
          <div
            class="border-accent/30 relative col-span-2 aspect-video w-full lg:col-span-1 lg:col-start-2 lg:row-start-1 overflow-hidden rounded-lg border bg-black shadow-[0_0_40px_-12px] shadow-cyan-400/30"
            data-stage-frame
          >
            <div class="text-muted absolute inset-0 grid place-content-center justify-items-center gap-4 p-6 text-center">
              <span
                class="border-accent/40 text-accent/70 grid size-14 place-items-center rounded-full border-2 border-dashed sm:size-16"
                aria-hidden="true"
              >
                <svg viewBox="0 0 24 24" class="ml-1 size-6 fill-current sm:size-7">
                  <path d="M8 5v14l11-7z" />
                </svg>
              </span>
              <p class="text-sm text-balance sm:text-lg">{t.stagePlaceholder}</p>
            </div>
          </div>
          <button
            type="button"
            class={`${navButtonClass} lg:col-start-1 lg:row-start-1`}
            data-player-prev
            data-player-nav
            hidden
          >
            <span class={navIconClass} aria-hidden="true">
              <svg viewBox="0 0 24 24" class="size-5 fill-current lg:size-7">
                <path d="M6 5h2.5v14H6zM19 5v14L9.5 12z" />
              </svg>
            </span>
            <span class="lg:order-first">{t.previousVideo}</span>
          </button>
          <button
            type="button"
            class={`${navButtonClass} lg:col-start-3 lg:row-start-1`}
            data-player-next
            data-player-nav
            hidden
          >
            <span>{t.nextVideo}</span>
            <span class={navIconClass} aria-hidden="true">
              <svg viewBox="0 0 24 24" class="size-5 fill-current lg:size-7">
                <path d="M15.5 5H18v14h-2.5zM5 5v14l9.5-7z" />
              </svg>
            </span>
          </button>
        </div>
        <div class="mx-auto grid w-full max-w-4xl gap-3">
          {/* タイトル・公開元・YouTubeへのリンク。最初の動画が選ばれた時点でスクリプトが中身を作る。 */}
          <div class="grid gap-1" data-stage-info data-msg-open={t.openOnYouTube} hidden />
          {/* 再生の操作欄。プレイヤーには重ねず、下に置く（規約 RMF）。動画を選ぶまでは表示しない。 */}
          <div
            class="border-muted/20 grid gap-3 border-t pt-3"
            data-player-controls
            data-msg-position={t.queuePosition}
            data-msg-position-shuffle={t.queuePositionShuffle}
            data-msg-queue-end={t.queueEnd}
            data-msg-queue-repeat={t.queueRepeat}
            data-msg-queue-reshuffle={t.queueReshuffle}
            data-msg-up-next-repeat={t.upNextRepeat}
            data-msg-up-next-reshuffle={t.upNextReshuffle}
            data-msg-up-next-end={t.upNextEnd}
            data-msg-cued={t.nextCued}
            data-msg-autoplay-blocked={t.autoplayBlocked}
            data-msg-not-found={t.errorNotFound}
            data-msg-not-embeddable={t.errorNotEmbeddable}
            data-msg-identification={t.errorIdentification}
            data-msg-playback={t.errorPlayback}
            hidden
          >
            {/* 再生方法と繰り返し。設定はブラウザに保存しない。 */}
            <div class="flex flex-wrap items-center gap-x-5 gap-y-2">
              <fieldset class="flex flex-wrap items-center gap-2">
                <legend class="text-muted float-left mr-1 text-sm">{t.playOrder}</legend>
                {(
                  [
                    ['ordered', t.playOrdered],
                    ['shuffle', t.playShuffle],
                  ] as const
                ).map(([value, label]) => (
                  <label class="cursor-pointer">
                    <input
                      type="radio"
                      name="video-shelf-play-order"
                      value={value}
                      class="peer sr-only"
                      data-player-order
                      checked={value === 'ordered'}
                    />
                    <span class="bg-surface border-muted/30 peer-checked:border-accent/70 peer-checked:bg-accent/15 peer-checked:text-fg text-muted peer-focus-visible:outline-accent hover:border-accent/60 inline-flex min-h-11 items-center rounded-full border px-4 text-sm transition-colors peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2">
                      {label}
                    </span>
                  </label>
                ))}
              </fieldset>
              <label class="inline-flex min-h-11 cursor-pointer items-center gap-2 text-sm">
                <input type="checkbox" role="switch" class="peer sr-only" data-player-repeat />
                <span
                  class="bg-surface border-muted/40 peer-checked:border-accent/70 peer-checked:bg-accent/20 peer-focus-visible:outline-accent relative h-6 w-11 rounded-full border transition-colors peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 after:absolute after:top-0.5 after:left-0.5 after:size-4.5 after:rounded-full after:bg-current after:transition-transform peer-checked:after:translate-x-5"
                  aria-hidden="true"
                ></span>
                {t.repeatQueue}
              </label>
            </div>
            <p class="text-muted text-xs" aria-live="polite" data-player-position></p>
            <p class="text-warm text-sm empty:hidden" role="status" data-player-message></p>
            {/* 次に流れる動画（キュー表示）。押すとその動画へ移る。 */}
            <details class="group border-muted/20 rounded-lg border" open data-player-upnext hidden>
              <summary class="hover:text-fg flex min-h-11 cursor-pointer list-none items-center gap-2 rounded-lg px-3 text-sm font-semibold [&::-webkit-details-marker]:hidden">
                <span
                  class="text-accent text-xs transition-transform group-open:rotate-90 motion-reduce:transition-none"
                  aria-hidden="true"
                >
                  ▶
                </span>
                {t.upNext}
              </summary>
              <ol class="grid gap-1 px-2 pb-2 empty:hidden" data-player-upnext-list></ol>
              <p class="text-muted px-3 pb-3 text-xs empty:hidden" data-player-upnext-note></p>
            </details>
            {import.meta.env.DEV && (
              // 区間の記録（開発環境のみ。本番のビルドには含めない）。開発者向けのため日本語だけ。
              <section
                class="border-warm/40 grid gap-3 rounded-lg border border-dashed p-3"
                aria-labelledby="segment-recorder-title"
                data-segment-recorder
              >
                <h2 id="segment-recorder-title" class="text-warm text-sm font-semibold">
                  区間の記録（開発環境のみ）
                </h2>
                <p class="text-muted text-xs">
                  再生中に「開始を記録」「終了を記録」を押すと、playlists.json の items
                  に貼れる形にします。タイトルは手動で記入したものだけを書き写します。
                </p>
                <div class="flex flex-wrap gap-2">
                  <button
                    type="button"
                    class="bg-surface border-muted/30 hover:border-accent/60 inline-flex min-h-11 items-center rounded-full border px-4 text-sm transition-colors disabled:cursor-not-allowed disabled:opacity-40"
                    data-segment-start
                  >
                    開始を記録
                  </button>
                  <button
                    type="button"
                    class="bg-surface border-muted/30 hover:border-accent/60 inline-flex min-h-11 items-center rounded-full border px-4 text-sm transition-colors disabled:cursor-not-allowed disabled:opacity-40"
                    data-segment-end
                  >
                    終了を記録
                  </button>
                  <button
                    type="button"
                    class="bg-surface border-muted/30 hover:border-accent/60 inline-flex min-h-11 items-center rounded-full border px-4 text-sm transition-colors disabled:cursor-not-allowed disabled:opacity-40"
                    data-segment-copy
                    disabled
                  >
                    コピー
                  </button>
                  <button
                    type="button"
                    class="bg-surface border-muted/30 hover:border-accent/60 inline-flex min-h-11 items-center rounded-full border px-4 text-sm transition-colors disabled:cursor-not-allowed disabled:opacity-40"
                    data-segment-clear
                  >
                    クリア
                  </button>
                </div>
                <p class="text-muted text-xs" aria-live="polite" data-segment-status></p>
                <textarea
                  class="bg-subtle border-muted/30 w-full rounded-md border p-2 font-mono text-xs"
                  rows="8"
                  readonly
                  aria-label="playlists.json に貼る項目"
                  data-segment-output
                ></textarea>
              </section>
            )}
          </div>
        </div>
      </div>
    ) : (
      <p class="bg-surface border-muted/25 text-muted mb-12 rounded-lg border p-6">{t.noVideos}</p>
    )}

    {hasVideos && (
      // 絞り込み。JavaScriptが無効な場合は使えないため、スクリプトで表示する。
      <div
        id="video-filter"
        class="bg-subtle border-muted/20 mb-10 grid gap-4 rounded-lg border p-4 sm:p-5"
        hidden
      >
        <div class="grid gap-2">
          <label for="video-query" class="text-sm font-semibold">
            {t.searchVideos}
          </label>
          <input
            id="video-query"
            type="search"
            placeholder={t.videoSearchPlaceholder}
            class="bg-surface border-muted/40 min-h-11 w-full max-w-md rounded-md border px-3"
          />
        </div>
        <fieldset class="grid gap-2">
          <legend class="mb-2 text-sm font-semibold">{t.videoKind}</legend>
          <div class="flex flex-wrap gap-2">
            {(
              [
                ['all', t.kindAll],
                ['regular', t.kindRegular],
                ['shorts', 'Shorts'],
                ['live', t.kindLive],
              ] as const
            ).map(([value, label]) => (
              <label class="bg-surface border-muted/30 has-checked:border-accent/70 has-checked:text-accent has-focus-visible:outline-accent inline-flex min-h-11 cursor-pointer items-center rounded-full border px-4 text-sm transition-colors has-focus-visible:outline-2 has-focus-visible:outline-offset-2">
                <input
                  type="radio"
                  name="video-kind"
                  value={value}
                  class="sr-only"
                  checked={value === 'all'}
                />
                {label}
              </label>
            ))}
          </div>
        </fieldset>
        {usedCategories.length > 1 && (
          <fieldset class="grid gap-2">
            <legend class="mb-2 text-sm font-semibold">{t.category}</legend>
            <div class="flex flex-wrap gap-2">
              {[
                { id: 'all', label: t.kindAll },
                ...usedCategories.map((category) => ({
                  id: category.id,
                  label: categoryName(category.id),
                })),
              ].map(({ id, label }) => (
                <label class="bg-surface border-muted/30 has-checked:border-accent/70 has-checked:text-accent has-focus-visible:outline-accent inline-flex min-h-11 cursor-pointer items-center rounded-full border px-4 text-sm transition-colors has-focus-visible:outline-2 has-focus-visible:outline-offset-2">
                  <input
                    type="radio"
                    name="video-category"
                    value={id}
                    class="sr-only"
                    checked={id === 'all'}
                  />
                  {label}
                </label>
              ))}
            </div>
          </fieldset>
        )}
        {sceneTags.length > 0 && (
          // プレイリストの項目のタグ（シーンを探す）。1つだけ選べる。
          <fieldset class="grid gap-2">
            <legend class="mb-2 text-sm font-semibold">{t.tags}</legend>
            <div class="flex flex-wrap gap-2">
              {[{ key: '', label: t.kindAll }, ...sceneTags].map(({ key, label }) => (
                <label class="bg-surface border-muted/30 has-checked:border-accent/70 has-checked:text-accent has-focus-visible:outline-accent inline-flex min-h-11 cursor-pointer items-center rounded-full border px-4 text-sm transition-colors has-focus-visible:outline-2 has-focus-visible:outline-offset-2">
                  <input
                    type="radio"
                    name="video-tag"
                    value={key}
                    class="sr-only"
                    checked={key === ''}
                  />
                  {key === '' ? label : `#${label}`}
                </label>
              ))}
            </div>
          </fieldset>
        )}
        <p
          id="video-count"
          role="status"
          class="text-muted text-sm"
          data-empty={t.noMatchingVideos}
          data-singular={
            locale === 'en' ? '1 matching video' : t.matchingVideos.replace('{count}', '1')
          }
          data-count={t.matchingVideos}
        ></p>
      </div>
    )}

    {playlists.length > 0 && (
      <section aria-labelledby="playlists-title" class="mb-12 grid gap-8" data-filter-group>
        <h2 id="playlists-title" class="text-xl font-semibold">
          {t.playlists}
        </h2>
        {playlists.map((playlist) => (
          <section
            aria-labelledby={`playlist-${playlist.id}-title`}
            class="border-accent/30 grid min-w-0 gap-3 border-l-2 pl-4"
            data-filter-group
          >
            <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
              <h3 id={`playlist-${playlist.id}-title`} class="font-semibold">
                {playlistName(playlist)}
              </h3>
              <p class="text-muted text-xs">{countLabel(playlist.items.length)}</p>
            </div>
            <ShelfRow
              queueId={playlistQueueId(playlist.id)}
              label={playlistName(playlist)}
              items={playlist.items.map(playlistCard)}
            />
          </section>
        ))}
      </section>
    )}

    {fanPicks.length > 0 && (
      <section aria-labelledby="picks-title" class="mb-12" data-filter-group>
        <div class="mb-4 flex items-baseline justify-between gap-4">
          <h2 id="picks-title" class="text-xl font-semibold">
            {t.picks}
          </h2>
          <p class="text-muted text-sm">{countLabel(fanPicks.length)}</p>
        </div>
        <ul
          class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3"
          data-queue-id="picks"
          data-queue-label={t.picks}
        >
          {fanPicks.map((video) => (
            <VideoCard {...pickCard(video)} />
          ))}
        </ul>
      </section>
    )}

    {fanShelves.length > 0 && (
      <section aria-labelledby="channel-latest-title" class="mb-12 grid gap-8" data-filter-group>
        <h2 id="channel-latest-title" class="text-xl font-semibold">
          {t.channelLatest}
        </h2>
        {fanShelves.map(({ channel, uploads }) => (
          <section
            aria-labelledby={`channel-${channel.id}-title`}
            class="border-muted/20 grid min-w-0 gap-3 border-l-2 pl-4"
            data-filter-group
          >
            <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
              <h3
                id={`channel-${channel.id}-title`}
                class="flex flex-wrap items-baseline gap-x-2 gap-y-1 font-semibold"
              >
                <a
                  href={youtubeChannelUrl(channel.channelId)}
                  class="hover:text-accent underline-offset-4 hover:underline"
                >
                  {channel.name}
                </a>
                {channel.categories.map((id) => (
                  <span class="text-warm font-mono text-xs">{categoryName(id)}</span>
                ))}
              </h3>
              <p class="text-muted text-xs">
                {t.fetchedAt.replace('{date}', fetchedAtFormat.format(uploads.fetchedAt))}
              </p>
            </div>
            {uploads.status === 'error' ? (
              <p class="text-muted text-sm">{t.fetchFailed}</p>
            ) : (
              uploads.videos.length === 0 && <p class="text-muted text-sm">{t.noUploads}</p>
            )}
            <ChannelShelfRows
              channel={channel}
              locale={locale}
              items={uploads.videos.map((video) => uploadCard(channel, video))}
            />
          </section>
        ))}
      </section>
    )}

    {ownerChannel && ownerUploads && (
      // 管理人のチャンネルは「おまけ」として、推しチャンネルの後ろに控えめに置く。
      <section
        aria-labelledby="owner-corner-title"
        class="border-warm/25 bg-subtle/60 mb-12 grid min-w-0 gap-6 rounded-xl border p-4 sm:p-6"
        data-filter-group
      >
        <header class="grid gap-1">
          <p class="text-warm font-mono text-xs tracking-widest">{t.ownerEyebrow}</p>
          <h2 id="owner-corner-title" class="text-lg font-semibold">
            {t.ownerCorner}
          </h2>
          <p class="text-muted text-sm">
            {t.ownerNote}
            <a
              href={youtubeChannelUrl(ownerChannel.channelId)}
              class="text-warm hover:text-fg ml-1 underline-offset-4 hover:underline"
            >
              {ownerChannel.name}
            </a>
          </p>
        </header>
        {ownerPopular.length > 0 && (
          <section aria-labelledby="owner-works-title" class="grid min-w-0 gap-3" data-filter-group>
            <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
              <h3 id="owner-works-title" class="text-sm font-semibold">
                {t.ownerWorks}
              </h3>
              <p class="text-muted text-xs">{t.ownerWorksNote}</p>
            </div>
            <ShelfRow
              queueId="owner-works"
              label={t.ownerWorks}
              variant="compact"
              items={ownerPopular.map((video) => uploadCard(ownerChannel, video))}
            />
          </section>
        )}
        <section aria-labelledby="owner-latest-title" class="grid min-w-0 gap-3" data-filter-group>
          <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
            <h3 id="owner-latest-title" class="text-sm font-semibold">
              {t.ownerLatest}
            </h3>
            <p class="text-muted text-xs">
              {t.fetchedAt.replace('{date}', fetchedAtFormat.format(ownerUploads.fetchedAt))}
            </p>
          </div>
          {ownerUploads.status === 'error' ? (
            <p class="text-muted text-sm">{t.fetchFailed}</p>
          ) : (
            ownerUploads.videos.length === 0 && <p class="text-muted text-sm">{t.noUploads}</p>
          )}
          <ChannelShelfRows
            channel={ownerChannel}
            locale={locale}
            variant="compact"
            items={ownerUploads.videos.map((video) => uploadCard(ownerChannel, video))}
          />
        </section>
      </section>
    )}

    {activeChannels.length > 0 && (
      <section aria-labelledby="channel-list-title" class="mb-12">
        <h2 id="channel-list-title" class="mb-4 text-xl font-semibold">
          {t.registeredChannels}
        </h2>
        <ul class="flex flex-wrap gap-2">
          {[...fanChannels, ...(ownerChannel ? [ownerChannel] : [])].map((channel) => (
            <li>
              <a
                href={youtubeChannelUrl(channel.channelId)}
                class:list={[
                  'bg-surface hover:border-accent/60 inline-flex min-h-11 flex-wrap items-center gap-x-2 rounded-full border px-4 text-sm transition-colors',
                  channel.owner ? 'border-warm/40' : 'border-muted/25',
                ]}
              >
                {channel.name}
                {channel.owner && <span class="text-warm text-xs">{t.ownerBadge}</span>}
                {channel.categories.map((id) => (
                  <span class="text-warm font-mono text-xs">{categoryName(id)}</span>
                ))}
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    <footer class="border-muted/20 text-muted grid gap-2 border-t pt-6 text-xs">
      <p>{t.playerNotice}</p>
      {hasApiData && <p>{t.apiNotice}</p>}
      <p class="flex flex-wrap gap-x-4 gap-y-1">
        <a
          href="https://www.youtube.com/t/terms"
          class="hover:text-fg underline underline-offset-4"
          rel="noopener noreferrer"
        >
          {t.youtubeTerms}
        </a>
        <a
          href="https://policies.google.com/privacy"
          class="hover:text-fg underline underline-offset-4"
          rel="noopener noreferrer"
        >
          {t.googlePrivacy}
        </a>
      </p>
    </footer>
  </section>
</BaseLayout>

<script>
  import { FILTER_CHANGE_EVENT, initVideoShelfPlayer } from '../lib/videoShelfPlayer';
  import {
    VIDEO_KINDS,
    isFilterActive,
    matchesVideoFilter,
    nextShelfCount,
    normalizeSearchText,
    parseSearchTerms,
    type VideoKind,
  } from '../lib/videoShelf';

  // 再生ステージ（前へ・次へ、連続再生、再生できない動画の処理）。連続再生は常にON。
  const player = initVideoShelfPlayer();

  // 区間の記録は開発環境だけで読み込む（本番のビルドでは、この分岐ごと取り除かれる）。
  if (import.meta.env.DEV) {
    void import('../lib/videoSegmentRecorder').then(({ initSegmentRecorder }) =>
      initSegmentRecorder(player),
    );
  }

  // タイトル・チャンネル名・メモ・タグでの検索と、種別・カテゴリ・タグでの絞り込み。
  const filter = document.querySelector<HTMLElement>('#video-filter');
  const query = document.querySelector<HTMLInputElement>('#video-query');
  const count = document.querySelector<HTMLElement>('#video-count');
  const kindInputs = Array.from(
    document.querySelectorAll<HTMLInputElement>('input[name="video-kind"]'),
  );
  const categoryInputs = Array.from(
    document.querySelectorAll<HTMLInputElement>('input[name="video-category"]'),
  );
  const tagInputs = Array.from(
    document.querySelectorAll<HTMLInputElement>('input[name="video-tag"]'),
  );
  const parseTags = (value: string | undefined): string[] => {
    if (!value) return [];
    try {
      const parsed: unknown = JSON.parse(value);
      return Array.isArray(parsed) ? parsed.filter((tag) => typeof tag === 'string') : [];
    } catch {
      return [];
    }
  };
  const isVideoKind = (value: string | undefined): value is VideoKind =>
    VIDEO_KINDS.some((kind) => kind === value);
  const disclosures = new Map(
    Array.from(document.querySelectorAll<HTMLButtonElement>('[data-expand-shelf]'), (button) => [
      button.getAttribute('aria-controls'),
      button,
    ]),
  );
  // 棚ごとに、いま並べている本数を持つ（最初は data-initial の本数）。
  const shelfCounts = new Map(
    Array.from(disclosures.values(), (button) => [button, Number(button.dataset.initial)]),
  );
  const items = Array.from(document.querySelectorAll<HTMLElement>('[data-video-item]'), (item) => ({
    item,
    videoId: item.querySelector<HTMLElement>('[data-video-card]')?.dataset.videoId ?? '',
    // 棚の中での並び順（0始まり）
    index: Array.prototype.indexOf.call(item.parentElement?.children ?? [], item),
    disclosure: item.hasAttribute('data-older-video')
      ? disclosures.get(item.parentElement?.id ?? '')
      : undefined,
    target: {
      searchText: normalizeSearchText(item.dataset.search ?? ''),
      kind: isVideoKind(item.dataset.kind) ? item.dataset.kind : undefined,
      categories: (item.dataset.categories ?? '').split(' ').filter(Boolean),
      tags: parseTags(item.dataset.tags),
    },
  }));
  // 内側のまとまりから先に判定するため、文書順の逆に並べる。
  const groups = Array.from(
    document.querySelectorAll<HTMLElement>('[data-filter-group]'),
  ).reverse();

  if (filter && query && count && items.length > 0) {
    const updateResults = () => {
      const selectedKind = kindInputs.find((input) => input.checked)?.value;
      const videoFilter = {
        terms: parseSearchTerms(query.value),
        kind: isVideoKind(selectedKind) ? selectedKind : ('all' as const),
        category: categoryInputs.find((input) => input.checked)?.value ?? 'all',
        // 「すべて」の値は空文字。
        tag: tagInputs.find((input) => input.checked)?.value || undefined,
      };
      const active = isFilterActive(videoFilter);
      for (const button of disclosures.values()) {
        button.hidden = active;
        // YouTubeへの案内は、棚の動画をすべて並べたとき（絞り込み中を含む）に表示する。
        const more = button.parentElement?.querySelector<HTMLElement>('[data-shelf-more]');
        if (more) {
          more.hidden = !active && (shelfCounts.get(button) ?? 0) < Number(button.dataset.total);
        }
      }
      // おすすめと新着の両方にある動画は1本として数える。
      const matched = new Set<string>();
      for (const entry of items) {
        const collapsed =
          entry.disclosure !== undefined && entry.index >= (shelfCounts.get(entry.disclosure) ?? 0);
        const matches = matchesVideoFilter(entry.target, videoFilter);
        // 折りたたみで隠れているだけの動画は再生の対象に残すため、絞り込みで外れた動画には別の印を付ける。
        entry.item.toggleAttribute('data-filtered-out', !matches);
        entry.item.hidden = (!active && collapsed) || !matches;
        if (!entry.item.hidden) matched.add(entry.videoId);
      }
      // 絞り込み中は、該当する動画が1本もない棚（取得失敗などの棚を含む）を隠す。
      for (const group of groups) group.hidden = false;
      for (const group of groups) {
        group.hidden =
          active &&
          !items.some(
            ({ item }) =>
              !item.hidden &&
              group.contains(item) &&
              item.parentElement?.closest('[data-filter-group][hidden]') === null,
          );
      }
      count.textContent =
        (matched.size === 0
          ? count.dataset.empty
          : matched.size === 1
            ? count.dataset.singular
            : count.dataset.count?.replace('{count}', String(matched.size))) ?? '';
      // 再生の操作欄に、飛ばす動画が変わったことを知らせる。
      document.dispatchEvent(new Event(FILTER_CHANGE_EVENT));
    };

    filter.hidden = false;
    updateResults();
    query.addEventListener('input', updateResults);
    for (const input of [...kindInputs, ...categoryInputs, ...tagInputs]) {
      input.addEventListener('change', updateResults);
    }
    for (const button of disclosures.values()) {
      button.addEventListener('click', () => {
        const initial = Number(button.dataset.initial);
        const total = Number(button.dataset.total);
        const previous = shelfCounts.get(button) ?? initial;
        const visible = nextShelfCount(previous, total, initial);
        shelfCounts.set(button, visible);
        const label =
          (visible < total
            ? button.dataset.show?.replace('{count}', String(total - visible))
            : button.dataset.hide) ?? '';
        button.setAttribute('aria-expanded', String(visible > initial));
        button.setAttribute('aria-label', `${label} · ${button.dataset.label ?? ''}`);
        button.textContent = label;
        updateResults();

        // 追加した先頭のカードを棚の左端へ寄せ、増えたことが分かるようにする（閉じたときは先頭へ戻す）。
        const list = document.getElementById(button.getAttribute('aria-controls') ?? '');
        const first = list?.children[visible > previous ? previous : 0];
        if (list && first) {
          const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          list.scrollBy({
            left: first.getBoundingClientRect().left - list.getBoundingClientRect().left,
            behavior: reduceMotion ? 'auto' : 'smooth',
          });
        }
      });
    }
    // ブラウザの「戻る」で入力内容が復元された場合にも結果を合わせる。
    window.addEventListener('pageshow', updateResults);
  }
</script>
